# Database
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms?schema=public"

# API
PORT=4000
HOST=0.0.0.0
CMS_JWT_SECRET="dev-jwt-secret-change-me"
# Studio / default browser origins (comma-separated). Per-website frontends
# should use Website.allowedOrigins in Admin → Website instead.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Absolute base for uploaded media URLs (defaults to request host)
# PUBLIC_API_URL="http://localhost:4000"

# Apps (admin + web)
NEXT_PUBLIC_CMS_API_URL="http://localhost:4000"
# Public demo site — matches seeded demo user (pnpm db:seed)
NEXT_PUBLIC_CMS_SITE_KEY="demo-site-key"

# AI — optional. Only used by db:seed to prefill the demo account.
# New registrations start with no AI config (configure in Admin → AI).
CMS_AI_BASE_URL="https://api.openai.com/v1"
CMS_AI_API_KEY=""
CMS_AI_MODEL="gpt-4o-mini"
