# Copy to deploy/.env on the Pi (never commit the real file).

# Postgres
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=cms

# API
CMS_JWT_SECRET=change-me-long-random
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://admin.example.com,https://www.example.com

# Next apps (baked into images at build time — rebuild after changing)
NEXT_PUBLIC_CMS_API_URL=https://api.example.com
NEXT_PUBLIC_CMS_SITE_KEY=your-site-key

# Optional seed-time AI defaults (usually configure in Admin instead)
CMS_AI_BASE_URL=
CMS_AI_API_KEY=
CMS_AI_MODEL=

# Cloudflare Zero Trust tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
