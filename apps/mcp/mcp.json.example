{
  "mcpServers": {
    "aurora": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/apps/mcp/dist/index.js"],
      "env": {
        "CMS_API_URL": "http://localhost:4000",
        "CMS_USER_TOKEN": "aur_u_YOUR_PERSONAL_TOKEN",
        "CMS_WEBSITE_ID": "OPTIONAL_DEFAULT_WEBSITE_ID"
      }
    }
  }
}
