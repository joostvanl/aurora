generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntryStatus {
  draft
  published
}

enum FieldType {
  text
  textarea
  richtext
  boolean
  datetime
  number
  slug
  media
  relation
  relations
  username
  password
}

enum FormFieldType {
  text
  email
  phone
  textarea
  number
  select
  radio
  checkbox
  honeypot
}

/// editor = content; builder = schema+content (no members/AI); admin = everything
enum WebsiteRole {
  editor
  builder
  admin
}

/// How entries of a content type relate to site locales.
enum LocalizationMode {
  /// Only locales explicitly created for each entry (Add translation).
  explicit
  /// Creating an entry also creates draft siblings for every site locale.
  all_locales
}

/// Outlook-like cadence for ScheduledTask (CMS-20).
enum ScheduledTaskFrequency {
  once
  daily
  weekly
  monthly
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  memberships  Membership[]
  userApiTokens UserApiToken[]
  createdEntries Entry[]
  entryVersions EntryVersion[]
  contentTypeVersions ContentTypeVersion[]
  auditEvents  AuditEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Website {
  id           String         @id @default(cuid())
  name         String
  /** Optional internal note for studio admins (not public site chrome). */
  description  String?
  siteKey      String         @unique @default(cuid())
  /**
   * Browser origins allowed to call the API for this website (CORS).
   * Example: ["http://localhost:5180", "https://app.example.com"]
   * Merged with global CORS_ORIGINS (studio defaults) at runtime.
   */
  allowedOrigins String[]     @default([])
  /** BCP-47 language-REGION tags enabled for this website, e.g. ["en-US","nl-NL"]. */
  locales        String[]     @default(["en-US"])
  /** Must be one of `locales`. Used when public/admin omit ?locale=. */
  defaultLocale  String       @default("en-US")
  memberships  Membership[]
  contentTypes ContentType[]
  forms        Form[]
  settings     Setting[]
  apiTokens    ApiToken[]
  aiUsageEvents AiUsageEvent[]
  contentRequestEvents ContentRequestEvent[]
  scheduledTasks ScheduledTask[]
  auditEvents  AuditEvent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Membership {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteId String
  website   Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  role      WebsiteRole @default(editor)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, websiteId])
  @@index([websiteId])
}

/// Long-lived management token for agents / automation (write API).
/// Bound to a website; acts with admin privileges for that website.
model ApiToken {
  id         String    @id @default(cuid())
  websiteId  String
  website    Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdById String?
  name       String
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([websiteId])
}

/// Personal access token for a user (MCP / agents). Not bound to a website;
/// call select-website to obtain a JWT with membership role for a site.
model UserApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model ContentType {
  id               String            @id @default(cuid())
  websiteId        String
  website          Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  apiId            String
  name             String
  description      String?
  localizationMode LocalizationMode  @default(explicit)
  fields           FieldDefinition[]
  entries          Entry[]
  versions         ContentTypeVersion[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([websiteId, apiId])
}

model FieldDefinition {
  id            String            @id @default(cuid())
  contentTypeId String
  contentType   ContentType       @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  apiId         String
  name          String
  type          FieldType
  required      Boolean           @default(false)
  sortOrder     Int               @default(0)
  /** Type-specific config, e.g. { relatedContentTypeApiId: "author" } for relation fields. */
  settings      Json?
  values        EntryFieldValue[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([contentTypeId, apiId])
  @@index([contentTypeId, sortOrder])
}

model Entry {
  id            String            @id @default(cuid())
  contentTypeId String
  contentType   ContentType       @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  slug          String
  status        EntryStatus       @default(draft)
  locale        String            @default("en-US")
  /** User who created this entry. Immutable after create; null for legacy/system rows. */
  createdByUserId String?
  createdBy     User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  fieldValues   EntryFieldValue[]
  versions      EntryVersion[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([contentTypeId, slug, locale])
  @@index([contentTypeId, status])
  @@index([contentTypeId, publishedAt])
  @@index([createdByUserId])
}

model EntryFieldValue {
  id      String          @id @default(cuid())
  entryId String
  entry   Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  fieldId String
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   Json

  @@unique([entryId, fieldId])
  @@index([fieldId])
}

model EntryVersion {
  id              String   @id @default(cuid())
  entryId         String
  entry           Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  label           String?
  source          String
  snapshot        Json
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  /** user | ai | system */
  actorKind       String?
  changeSummary   String?
  createdAt       DateTime @default(now())

  @@index([entryId, createdAt])
  @@index([createdByUserId])
}

model ContentTypeVersion {
  id              String      @id @default(cuid())
  contentTypeId   String
  contentType     ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  label           String?
  source          String
  snapshot        Json
  createdByUserId String?
  createdBy       User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  /** user | ai | system */
  actorKind       String?
  changeSummary   String?
  createdAt       DateTime    @default(now())

  @@index([contentTypeId, createdAt])
  @@index([createdByUserId])
}

/// Append-only audit trail for content + schema mutations (CMS-33).
model AuditEvent {
  id           String   @id @default(cuid())
  websiteId    String
  website      Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /** user | ai | system */
  actorKind    String
  action       String
  resourceType String
  resourceId   String
  summary      String
  meta         Json?
  createdAt    DateTime @default(now())
  /** Append-only AI enrichment (CMS-48). Never overwrites summary/action/actor*. */
  aiDetail           String?
  aiDetailActorKind  String?
  aiDetailCreatedAt  DateTime?
  aiDetailSource     String?

  @@index([websiteId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId])
}

model Setting {
  id        String   @id @default(cuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([websiteId, key])
}

/// Unattended AI agent task (Settings → Taken). Prompt is denormalized from dock macros.
model ScheduledTask {
  id              String                  @id @default(cuid())
  websiteId       String
  website         Website                 @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name            String
  /// Prompt executed by the AI agent (copied from macro at save when macroId set).
  prompt          String
  /// Soft link to ai.macros[].id; optional after prompt is denormalized.
  macroId         String?
  enabled         Boolean                 @default(true)
  /// When true, scheduled agent runs may publish entries (admin opt-in).
  allowPublish    Boolean                 @default(false)
  /// Optional soft cap on total LLM tokens for one run (null = no extra cap).
  maxTokens       Int?
  /// Optional soft cap on tool invocations for one run (null = agent default steps).
  maxToolCalls    Int?
  frequency       ScheduledTaskFrequency
  /// Local wall-clock time "HH:mm" in `timeZone`.
  timeOfDay       String
  /// IANA timezone, e.g. "Europe/Amsterdam".
  timeZone        String                  @default("Europe/Amsterdam")
  /// weekly: 0=Sunday … 6=Saturday (JS getDay).
  byWeekday       Int?
  /// monthly: day of month 1–31 (clamped to month length).
  byMonthDay      Int?
  startAt         DateTime
  endAt           DateTime?
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  lastStatus      String?
  lastError       String?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  runs            ScheduledTaskRun[]

  @@index([enabled, nextRunAt])
  @@index([websiteId])
}

model ScheduledTaskRun {
  id               String        @id @default(cuid())
  taskId           String
  task             ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  ok               Boolean       @default(false)
  summary          String?
  reply            String?
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  toolCallCount    Int           @default(0)
  uniqueToolCount  Int           @default(0)
  /// completed | max_tokens | max_tool_calls | error | timeout
  stoppedReason    String?
  createdAt        DateTime      @default(now())

  @@index([taskId, startedAt])
}

/** One LLM chat-completion call’s token usage for metering. */
model AiUsageEvent {
  id               String   @id @default(cuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  userId           String?
  source           String
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([websiteId, createdAt])
}

/** One successful public content API request (site-key) for page-view metering. */
model ContentRequestEvent {
  id               String   @id @default(cuid())
  websiteId        String
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  /** Content type apiId at request time. */
  contentTypeApiId String
  /** Entry slug when a single entry was fetched; null for list requests. */
  entrySlug        String?
  /** "list" | "get" */
  kind             String
  createdAt        DateTime @default(now())

  @@index([websiteId, createdAt])
}

model Form {
  id             String           @id @default(cuid())
  websiteId      String
  website        Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  apiId          String
  name           String
  description    String?
  submitLabel    String           @default("Submit")
  successMessage String           @default("Thanks — we received your message.")
  enabled        Boolean          @default(true)
  fields         FormField[]
  submissions    FormSubmission[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([websiteId, apiId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  apiId       String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  helpText    String?
  options     Json?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([formId, apiId])
  @@index([formId, sortOrder])
}

model FormSubmission {
  id        String    @id @default(cuid())
  formId    String
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  payload   Json
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([formId, createdAt])
}
